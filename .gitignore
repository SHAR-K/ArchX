# 依赖与构建产物
node_modules/
dist/
build/
*.tsbuildinfo
*.vsix

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# 引擎二进制由 tools/build-archcheck-engine.ps1 构建，不进版本库
extension/engines/*/archcheck.exe
extension/engines/*/engine-manifest.json

# 分析产物与本地状态
.arch-report/
.archx/
.archx-host/
work/
reports/

# 编辑器
.vscode/settings.json
.DS_Store
# MCP 服务器是打包产物（源码在 extension/mcp/，要和 facts-view 编在一起）

# corpus 的编译数据库按 clone 位置生成：node tools/corpus-prepare.mjs
corpus/*/compile_commands.json

# 外部语料按 corpus/external.yaml 里的 commit clone 到这里，不入库
corpus/external/
